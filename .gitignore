# build output
/bin/
/build/
/dist/
*.exe
*.test
*.out

# databases / caches (rebuildable)
*.db
*.db-shm
*.db-wal
.vfs/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
node_modules/

# local scratch
/tmp/
*.log
# tracked QA evidence logs are product evidence, not scratch (QA-LORE-7)
!docs/qa/evidence/**/*.log
.env
.env.*
!.env.example

# gitreins runtime artifacts (guard logs, judge usage ledger)
.gitreins/tasks.yaml
.gitreins/tasks.yaml.lock
.gitreins/config.yaml.bak
.gitreins/usage.jsonl
.gitreins/logs/
.gitreins/qa-ledger.jsonl
.gitreins/review-state.json
.gitreins/review-state.lock

# lore's per-box local state (LORE-045: validate-history.jsonl is per-box
# EVIDENCE a lint ran HERE — per-cwd, never attestation, never committed)
.lore/
lore.egg-info/
get_h3_lore.egg-info/

# Agent-harness residue (not product artifacts). These trip `scripts/release.sh`
# clean-tree gate on every release dry-run while staying untracked, so a release
# readiness probe reads as dirty for reasons no reviewer can act on.
.digest/
.gitreins/rescued-*/
# single-path mutable last-run judge snapshot; per-run history under .gitreins/history/ stays tracked.
.gitreins/verdicts/
