[Unit]
Description=lore weekly dependency drift report
After=network-online.target
# Start-level failures (exec missing, user manager problems) append a dated
# failure-notice line to ~/.local/share/lore/dep-drift-failures.log. The report
# script itself still exits 0 when degraded, so the heartbeat in the report log
# remains the primary liveness signal; see deploy/systemd/README.md.
OnFailure=lore-dep-drift-failure.service

[Service]
Type=oneshot
WorkingDirectory=/home/kara/get-h3/lore
ExecStart=/home/kara/get-h3/lore/scripts/dep-drift.sh
Environment=HOME=/home/kara
StandardOutput=append:/home/kara/.local/share/lore/dep-drift.log
StandardError=inherit
